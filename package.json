{
  "name": "cineshelf",
  "version": "0.2.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "api": "npm --prefix backend start",
    "setup:api": "npm --prefix backend run setup",
    "test": "node --test tests/*.test.mjs",
    "test:api": "npm --prefix backend test",
    "check:bundle": "expo export --platform web --platform android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.13",
    "expo-linear-gradient": "~15.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "react-test-renderer": "^19.1.0"
  }
}
