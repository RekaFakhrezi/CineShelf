PORT=5002
HOST=0.0.0.0
# sqlite: uji lokal tanpa akun; supabase: database sesuai Modul 1.
DB_DRIVER=sqlite
SQLITE_PATH=./data/cineshelf.db
SUPABASE_URL=
# Hanya server! Jangan pernah salin key ini ke aplikasi mobile/GitHub.
SUPABASE_SERVICE_ROLE_KEY=
# Dibuat otomatis oleh npm run setup. Hanya untuk POST/PUT/DELETE katalog.
ADMIN_API_KEY=
# Kosong: semua origin boleh MEMBACA katalog publik. Mutasi tetap butuh admin key.
CORS_ORIGINS=
